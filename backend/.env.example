# RailAlert Environment Configuration (AWS Free Tier)
ENVIRONMENT=production
DEBUG=False
SECRET_KEY=railalert-production-secret-change-me-with-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL Connection (Local or AWS RDS db.t3.micro/db.t4g.micro)
DATABASE_URL=postgresql://railalert_user:strong_password@localhost:5432/railalert_db

# CORS Allowed Origins (Comma separated or standard JSON list)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://YOUR_EC2_PUBLIC_IP"]

# AWS Credentials (Optional in EC2 if using IAM Instance Role)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=railalert-vault-storage
S3_SSE_ALGORITHM=AES256

# AWS SES Transactional Email
AWS_SES_SENDER_EMAIL=no-reply@railalert.internal
